---
import { getProfile } from '../lib/content';
const p = await getProfile();
const year = new Date().getFullYear();
---

<footer class="on-dark bg-cuticle text-bone">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-2xl leading-tight">Prof. {p.name}</p>
      <p class="mt-2 max-w-sm text-bone-mute">{p.role}</p>
    </div>
    <div>
      <h2 class="font-sans text-sm font-semibold text-bone-mute">Write to</h2>
      <ul class="mt-3 space-y-1.5">
        {p.emails.map((e) => <li><a class="link" href={`mailto:${e}`}>{e}</a></li>)}
      </ul>
      <p class="mt-4 whitespace-pre-line text-bone-mute text-[0.95rem]">{p.address}</p>
    </div>
    <div>
      <h2 class="font-sans text-sm font-semibold text-bone-mute">Research profiles</h2>
      <ul class="mt-3 space-y-1.5">
        {p.links.scholar && <li><a class="link" href={p.links.scholar}>Google Scholar</a></li>}
        {p.links.orcid && <li><a class="link" href={`https://orcid.org/${p.links.orcid}`}>ORCID {p.links.orcid}</a></li>}
        {p.links.researchgate && <li><a class="link" href={p.links.researchgate}>ResearchGate</a></li>}
        {p.links.linkedin && <li><a class="link" href={p.links.linkedin}>LinkedIn</a></li>}
        {p.links.lab && <li><a class="link" href={p.links.lab}>Drosophila Research and Training Centre</a></li>}
      </ul>
    </div>
  </div>
  <div class="wrap border-t border-bone/10 py-6 text-sm text-bone-mute">
    © {year} {p.name}
  </div>
</footer>
