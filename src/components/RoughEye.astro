---
/**
 * Scroll chapter: a Drosophila compound eye that roughens as a toxicant takes hold and recovers on rescue.
 * Left column: a stage rail, plus for each stage an illustration and a caption explaining what the eye on
 * the right is doing, so the change is obvious even when the reader isn't watching the canvas.
 * Reduced motion: everything is shown as a plain list.
 */
const steps = [
  {
    label: 'The eye',
    title: "A fly's eye is a living readout",
    body: 'Some 800 identical units, the ommatidia, pack into an almost perfect honeycomb. When the cells beneath are harmed the pattern roughens, so damage becomes visible.',
    seeing: 'A healthy eye: every facet the same size, glossy and in perfect rows.',
  },
  {
    label: 'Exposure',
    title: 'Exposure',
    body: 'Pesticides, heavy metals, industrial solvents, nicotine and food additives reach the fly through its food, much as they reach people.',
    seeing: 'Gold particles drift in from the edges and are absorbed: the toxicant arriving.',
  },
  {
    label: 'Stress',
    title: 'Oxidative stress',
    body: "Reactive oxygen species outpace the cell's antioxidant defences, damaging lipids, proteins and mitochondria.",
    seeing: 'White sparks flicker across the facets: bursts of reactive oxygen species.',
  },
  {
    label: 'Damage',
    title: 'Degeneration',
    body: "Dopamine neurons are lost, climbing slows and lifespan shortens, the hallmarks of Parkinson's-like disease. In other tissues the same chemistry drives tumours and infertility.",
    seeing: 'Facets darken, shrink and slip out of line. This is what biologists call a rough eye.',
  },
  {
    label: 'Rescue',
    title: 'Rescue',
    body: 'Resveratrol, curcumin, hesperidin, kolaviron and astaxanthin restore redox balance and protect the cells. Each is a lead for prevention or therapy.',
    seeing: 'Order and shine return across the lattice as the protective compound takes effect.',
  },
];
---

<section id="exposure-to-rescue" class="chapter on-dark relative bg-cuticle text-bone" aria-labelledby="chapter-title">
  <div class="stage">
    <div class="wrap grid h-full grid-rows-[auto_1fr] gap-2 pt-20 pb-6 md:grid-cols-12 md:grid-rows-1 md:items-center md:gap-10 md:py-0">
      <div class="md:col-span-5">
        <h2 id="chapter-title" class="text-xl sm:text-2xl md:text-3xl">From exposure to rescue</h2>
        <p class="mt-2 hidden max-w-md text-bone-mute sm:block">How the lab follows a toxicant through a living animal, and tests what protects against it.</p>

        <ol class="rail mt-5 grid grid-cols-5 gap-1.5 md:mt-8" aria-hidden="true">
          {
            steps.map((s, i) => (
              <li class="rail-item" data-rail={i}>
                <span class="rail-bar" />
                <span class="rail-label">{s.label}</span>
              </li>
            ))
          }
        </ol>

        <ol class="steps mt-5 md:mt-8">
          {
            steps.map((s, i) => (
              <li class="step" data-step={i}>
                <div class="flex items-start gap-4 md:block">
                  <svg class="illus h-14 w-14 flex-none text-ochre-light md:h-24 md:w-24" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {i === 0 && (
                      <g>
                        <ellipse class="draw" pathLength="1" cx="60" cy="62" rx="38" ry="44" />
                        <path class="draw" pathLength="1" d="M60 30l8 4.6v9.2L60 48.4l-8-4.6v-9.2zM44 46l8 4.6v9.2L44 64.4l-8-4.6v-9.2zM76 46l8 4.6v9.2L76 64.4l-8-4.6v-9.2zM60 62l8 4.6v9.2L60 80.4l-8-4.6v-9.2zM44 78l8 4.6v9.2L44 96.4l-8-4.6v-9.2zM76 78l8 4.6v9.2L76 96.4l-8-4.6v-9.2z" />
                        <path class="draw" pathLength="1" d="M48 20c-4-8-10-12-16-12M72 20c4-8 10-12 16-12" />
                      </g>
                    )}
                    {i === 1 && (
                      <g>
                        <path class="draw" pathLength="1" d="M46 18h28M50 18v30L28 96a8 8 0 0 0 7 12h50a8 8 0 0 0 7-12L70 48V18" />
                        <path class="draw" pathLength="1" d="M36 84h48" />
                        <circle class="dot" cx="60" cy="96" r="3" fill="currentColor" stroke="none" />
                        <circle class="dot" cx="48" cy="98" r="2.4" fill="currentColor" stroke="none" />
                        <circle class="dot" cx="72" cy="94" r="2.4" fill="currentColor" stroke="none" />
                        <circle class="dot fall" cx="60" cy="4" r="2.6" fill="currentColor" stroke="none" />
                      </g>
                    )}
                    {i === 2 && (
                      <g>
                        <circle class="draw" pathLength="1" cx="42" cy="64" r="18" />
                        <circle class="draw" pathLength="1" cx="78" cy="64" r="18" />
                        <path class="draw" pathLength="1" d="M58 58h4M58 70h4" />
                        <circle class="dot pulse-dot" cx="98" cy="40" r="4" fill="currentColor" stroke="none" />
                        <path class="draw" pathLength="1" d="M100 14l-8 16h10l-8 16" />
                        <text x="42" y="70" font-size="16" fill="currentColor" stroke="none" text-anchor="middle" font-family="var(--font-sans)">O</text>
                        <text x="78" y="70" font-size="16" fill="currentColor" stroke="none" text-anchor="middle" font-family="var(--font-sans)">O</text>
                      </g>
                    )}
                    {i === 3 && (
                      <g>
                        <circle class="draw" pathLength="1" cx="40" cy="60" r="12" />
                        <path class="draw" pathLength="1" d="M30 52L14 36M28 66L12 78M40 48V26M52 60h18" />
                        <path class="draw broken" pathLength="1" d="M70 60h8M84 60h6M96 60h8M104 60l6-8M104 60l6 8" />
                        <path class="draw" pathLength="1" d="M14 36l-6-2M40 26l-4-8" />
                      </g>
                    )}
                    {i === 4 && (
                      <g>
                        <path class="draw" pathLength="1" d="M30 46l13-7.5 13 7.5v15l-13 7.5-13-7.5z" />
                        <path class="draw" pathLength="1" d="M56 46l10-6 10 6M76 46l13-7.5 13 7.5v15l-13 7.5-13-7.5z" />
                        <path class="draw" pathLength="1" d="M30 61l-8 5M102 46l8-5M89 68.5v9" />
                        <path class="draw" pathLength="1" d="M38 104c0-18 12-28 30-28 0 18-12 28-30 28zM38 104l18-16" />
                      </g>
                    )}
                  </svg>
                  <div class="md:mt-5">
                    <h3 class="flex items-baseline gap-3 font-display text-lg sm:text-xl md:text-2xl">
                      {i > 0 && <span class="font-sans text-base tabular-nums text-ochre-light">{i}</span>}
                      {s.title}
                    </h3>
                    <p class="mt-2 hidden max-w-md text-bone/85 sm:block md:mt-3">{s.body}</p>
                  </div>
                </div>
                <p class="seeing mt-4 max-w-md border-l-2 border-ochre-light/70 pl-4 text-[0.95rem] text-bone md:mt-6">
                  <span class="font-semibold text-ochre-light">What the eye shows:</span> {s.seeing}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="relative min-h-[34svh] md:col-span-7 md:h-[86svh]">
        <canvas id="eye" class="absolute inset-0 h-full w-full" role="img" aria-label="Illustration of a fruit fly compound eye whose regular hexagonal pattern becomes disordered with damage and recovers on rescue"></canvas>
      </div>
    </div>
  </div>
</section>

<style>
  .chapter {
    height: 520svh;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .rail-item {
    display: grid;
    gap: 0.45rem;
  }
  .rail-bar {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: color-mix(in oklab, var(--color-bone) 15%, transparent);
    overflow: hidden;
    position: relative;
  }
  .rail-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-ochre-light);
    transform: scaleX(var(--fill, 0));
    transform-origin: left;
  }
  .rail-label {
    font-size: 0.78rem;
    color: var(--color-bone-mute);
    transition: color 0.3s;
    white-space: nowrap;
  }
  .rail-item.is-active .rail-label {
    color: var(--color-bone);
    font-weight: 600;
  }
  .steps {
    display: grid;
  }
  .step {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(1.25rem);
    transition:
      opacity 0.5s var(--ease-out-soft),
      transform 0.6s var(--ease-out-soft),
      visibility 0s 0.5s;
  }
  .step.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.5s var(--ease-out-soft) 0.08s,
      transform 0.6s var(--ease-out-soft) 0.08s,
      visibility 0s;
  }
  /* illustration draws itself each time its stage becomes active */
  .step .draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.1s var(--ease-out-soft) 0.15s;
  }
  .step.is-active .draw {
    stroke-dashoffset: 0;
  }
  .step .broken {
    stroke-opacity: 0.5;
  }
  .step .dot {
    opacity: 0;
    transition: opacity 0.4s 0.6s;
  }
  .step.is-active .dot {
    opacity: 1;
  }
  .step.is-active .fall {
    animation: fall 1.6s ease-in infinite;
  }
  .step.is-active .pulse-dot {
    animation: blink 1.2s ease-in-out infinite;
  }
  @keyframes fall {
    from {
      transform: translateY(0);
      opacity: 1;
    }
    to {
      transform: translateY(80px);
      opacity: 0;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }
  .seeing {
    transition: border-color 0.3s;
  }
  @media (prefers-reduced-motion: reduce) {
    .chapter {
      height: auto;
    }
    .stage {
      position: static;
      height: auto;
    }
    .rail {
      display: none;
    }
    .steps {
      display: block;
    }
    .step {
      opacity: 1;
      visibility: visible;
      transform: none;
      margin-bottom: 2.5rem;
    }
    .step .draw {
      stroke-dashoffset: 0;
    }
    .step .dot {
      opacity: 1;
    }
  }
</style>

<script>
  const section = document.getElementById('exposure-to-rescue')!;
  const canvas = document.getElementById('eye') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const stepsEls = [...section.querySelectorAll<HTMLElement>('.step')];
  const railItems = [...section.querySelectorAll<HTMLElement>('.rail-item')];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Cell = { u: number; v: number; seed: number; seed2: number; ang: number };
  type Particle = { x: number; y: number; vx: number; vy: number; r: number; life: number };
  let cells: Cell[] = [];
  let particles: Particle[] = [];
  let w = 0,
    h = 0,
    dpr = 1;
  let progress = 0,
    shown = 0;
  let visible = false,
    raf = 0;

  // deterministic pseudo-random so the "damage" pattern is the same every visit
  let s = 7;
  const rnd = () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646;

  const build = () => {
    const r = canvas.getBoundingClientRect();
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = r.width;
    h = r.height;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    cells = [];
    s = 7;
    const n = 30; // facets across
    const step = 2 / n;
    for (let row = 0, v = -1; v <= 1; row++, v = -1 + row * step * 0.866) {
      for (let u = -1 + (row % 2) * (step / 2); u <= 1; u += step) {
        // keep cells inside the eye's kidney-ish outline
        const e = (u * u) / 1 + (v * v) / 1.0;
        if (e > 1) continue;
        cells.push({ u, v, seed: rnd(), seed2: rnd(), ang: rnd() * Math.PI * 2 });
      }
    }
  };

  const clamp = (x: number, a = 0, b = 1) => Math.min(b, Math.max(a, x));
  const ramp = (x: number, a: number, b: number) => clamp((x - a) / (b - a));

  // Stage curves from scroll progress p ∈ [0,1]
  const curves = (p: number) => {
    const exposure = ramp(p, 0.18, 0.36) * (1 - ramp(p, 0.8, 0.92));
    const ros = ramp(p, 0.38, 0.56) * (1 - ramp(p, 0.8, 0.95));
    const damage = ramp(p, 0.5, 0.76) * (1 - ramp(p, 0.82, 0.98) * 0.94);
    const rescue = ramp(p, 0.8, 0.96);
    return { exposure, ros, damage, rescue };
  };

  const hex = (x: number, y: number, r: number, rot = 0) => {
    ctx.beginPath();
    for (let i = 0; i < 6; i++) {
      const a = (Math.PI / 3) * i + rot;
      const px = x + r * Math.cos(a),
        py = y + r * Math.sin(a);
      i ? ctx.lineTo(px, py) : ctx.moveTo(px, py);
    }
    ctx.closePath();
  };

  const draw = (now: number) => {
    shown += (progress - shown) * (reduce ? 1 : 0.12);
    const { exposure, ros, damage, rescue } = curves(shown);
    const t = now / 1000;

    ctx.clearRect(0, 0, w, h);
    const cx = w / 2,
      cy = h / 2;
    const Rx = Math.min(w * 0.46, h * 0.42),
      Ry = Rx * 1.12;
    const k = 1.15; // curvature: facets shrink toward the rim like a dome
    const baseR = (Rx / 30) * 1.02;

    // soft dome shading under the facets
    const dome = ctx.createRadialGradient(cx - Rx * 0.3, cy - Ry * 0.35, Rx * 0.1, cx, cy, Rx * 1.1);
    dome.addColorStop(0, '#5a2414');
    dome.addColorStop(1, '#1a0f0a');
    ctx.beginPath();
    ctx.ellipse(cx, cy, Rx * 1.02, Ry * 1.02, 0, 0, Math.PI * 2);
    ctx.fillStyle = dome;
    ctx.fill();

    for (const c of cells) {
      const su = Math.sin(c.u * k) / Math.sin(k);
      const sv = Math.sin(c.v * k) / Math.sin(k);
      const shade = Math.cos(c.u * k * 0.9) * Math.cos(c.v * k * 0.9);
      const dying = damage * (c.seed < 0.55 ? 1 : 0.35); // a sub-population is hit hardest
      const jitter = dying * baseR * 0.9;
      const x = cx + su * Rx + Math.cos(c.ang) * jitter * c.seed2;
      const y = cy + sv * Ry + Math.sin(c.ang) * jitter * c.seed2;
      const r = baseR * (0.6 + 0.45 * shade) * (1 - dying * c.seed2 * 0.55);
      const rot = dying * (c.seed - 0.5) * 0.9;

      // facet colour: glossy drosopterin red → necrotic brown with damage → warm recovery
      const healthy = [184, 55, 32];
      const necrotic = [52, 28, 18];
      const mix = clamp(dying * (0.5 + c.seed2));
      const col = healthy.map((h0, i) => Math.round(h0 + (necrotic[i] - h0) * mix));
      hex(x, y, r, rot + Math.PI / 6);
      ctx.fillStyle = `rgb(${col[0]},${col[1]},${col[2]})`;
      ctx.fill();
      ctx.lineWidth = 0.8;
      ctx.strokeStyle = 'rgba(20,10,6,0.65)';
      ctx.stroke();

      // corneal lens highlight — dulls with damage
      const hl = (0.35 + 0.4 * shade) * (1 - mix * 0.9) + rescue * 0.15;
      const g = ctx.createRadialGradient(x - r * 0.3, y - r * 0.35, 0, x, y, r);
      g.addColorStop(0, `rgba(255,214,170,${0.55 * hl})`);
      g.addColorStop(0.6, `rgba(255,214,170,${0.08 * hl})`);
      g.addColorStop(1, 'rgba(255,214,170,0)');
      ctx.fillStyle = g;
      ctx.fill();

      // reactive oxygen species: brief sparks at stressed facets
      if (ros > 0.02 && c.seed2 < ros * 0.5) {
        const flick = 0.5 + 0.5 * Math.sin(t * 7 + c.seed * 40);
        ctx.beginPath();
        ctx.arc(x + r * 0.2, y - r * 0.2, r * 0.28 * flick, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,244,214,${0.7 * ros * flick})`;
        ctx.fill();
      }
    }

    // rescue: a warm wash across the restored lattice
    if (rescue > 0) {
      const wash = ctx.createRadialGradient(cx, cy, 0, cx, cy, Rx * 1.2);
      wash.addColorStop(0, `rgba(220,184,120,${0.16 * rescue})`);
      wash.addColorStop(1, 'rgba(220,184,120,0)');
      ctx.fillStyle = wash;
      ctx.beginPath();
      ctx.ellipse(cx, cy, Rx * 1.05, Ry * 1.05, 0, 0, Math.PI * 2);
      ctx.fill();
    }

    // toxicant particles drifting in from the edges
    const want = Math.round(exposure * 70);
    while (particles.length < want) {
      const a = Math.random() * Math.PI * 2;
      const d = Math.max(w, h) * 0.6;
      particles.push({
        x: cx + Math.cos(a) * d,
        y: cy + Math.sin(a) * d,
        vx: -Math.cos(a) * (0.4 + Math.random() * 0.6),
        vy: -Math.sin(a) * (0.4 + Math.random() * 0.6),
        r: 1 + Math.random() * 2.2,
        life: 1,
      });
    }
    if (particles.length > want) particles.length = want;
    for (const pt of particles) {
      pt.x += pt.vx;
      pt.y += pt.vy;
      const dx = pt.x - cx,
        dy = pt.y - cy;
      if ((dx * dx) / (Rx * Rx) + (dy * dy) / (Ry * Ry) < 0.9) {
        // absorbed: respawn at the edge
        const a = Math.random() * Math.PI * 2;
        const d = Math.max(w, h) * 0.6;
        pt.x = cx + Math.cos(a) * d;
        pt.y = cy + Math.sin(a) * d;
        pt.vx = -Math.cos(a) * (0.4 + Math.random() * 0.6);
        pt.vy = -Math.sin(a) * (0.4 + Math.random() * 0.6);
      }
      ctx.beginPath();
      ctx.arc(pt.x, pt.y, pt.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(196,154,85,${0.65 * exposure})`;
      ctx.fill();
    }

    if (visible && !reduce) raf = requestAnimationFrame(draw);
  };

  const measure = () => {
    const r = section.getBoundingClientRect();
    const total = r.height - window.innerHeight;
    progress = total > 0 ? clamp(-r.top / total) : 0;
    const idx = Math.min(stepsEls.length - 1, Math.floor(progress * stepsEls.length));
    stepsEls.forEach((el, i) => el.classList.toggle('is-active', i === idx));
    const per = 1 / railItems.length;
    railItems.forEach((el, i) => {
      el.classList.toggle('is-active', i === idx);
      el.style.setProperty('--fill', String(clamp((progress - i * per) / per)));
    });
  };

  build();
  if (reduce) {
    progress = 0;
    draw(0);
  } else {
    measure();
    window.addEventListener('scroll', measure, { passive: true });
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(draw);
      }
    }).observe(section);
  }
  let rt = 0;
  window.addEventListener('resize', () => {
    clearTimeout(rt);
    rt = window.setTimeout(() => {
      build();
      if (reduce) draw(0);
    }, 150);
  });
</script>
