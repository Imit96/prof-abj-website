---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="bg-ochre pt-32 pb-24 text-cuticle md:pt-44">
    <div class="wrap">
      <h1 class="text-4xl md:text-[5.5rem] md:leading-[0.95]">This page doesn't exist</h1>
      <p class="mt-6 max-w-xl text-lg">The link may be out of date. Try the research page or the full publication list.</p>
      <p class="mt-10 flex flex-wrap gap-3">
        <a href="/research" class="btn btn-ink">Go to research</a>
        <a href="/research#publications" class="btn btn-line">Browse publications</a>
      </p>
    </div>
  </section>
</Base>
