# Public site URL (used for canonical links, sitemap and social cards)
SITE_URL=https://abolaji.vercel.app

# Contact form: free access key from https://web3forms.com (delivered to his inbox)
PUBLIC_WEB3FORMS_KEY=

# CMS storage in production — set ONE of these:
# Keystatic Cloud project ("team/project") — lets him sign in with an email address
PUBLIC_KEYSTATIC_CLOUD_PROJECT=
# …or GitHub storage ("owner/repo") — editors need a GitHub account
PUBLIC_KEYSTATIC_GITHUB_REPO=
